# WAHA Enhanced Authentication Configuration
# Copy this file to .env and configure the values for your environment

# ============================================================================
# CORE AUTHENTICATION SETTINGS
# ============================================================================

# Enable the enhanced authentication system
# Set to 'true' to enable user management, JWT tokens, and role-based access
# Set to 'false' to use legacy API key authentication only
WAHA_AUTH_ENABLED=true

# JWT Secret Key (REQUIRED - Change this in production!)
# Must be at least 32 characters long for security
# Generate with: openssl rand -base64 32
WAHA_JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Token Expiration
# Format: number + unit (s=seconds, m=minutes, h=hours, d=days)
WAHA_JWT_EXPIRES_IN=24h

# Refresh Token Expiration
WAHA_REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================================================
# PASSWORD POLICY
# ============================================================================

# Minimum password length
WAHA_PASSWORD_MIN_LENGTH=8

# Password complexity requirements
WAHA_PASSWORD_REQUIRE_UPPERCASE=true
WAHA_PASSWORD_REQUIRE_LOWERCASE=true
WAHA_PASSWORD_REQUIRE_NUMBERS=true
WAHA_PASSWORD_REQUIRE_SYMBOLS=true

# ============================================================================
# RATE LIMITING
# ============================================================================

# Login Rate Limiting
# Maximum failed login attempts before temporary lockout
WAHA_LOGIN_RATE_LIMIT_ATTEMPTS=5

# Time window for login attempts (milliseconds)
# 900000 = 15 minutes
WAHA_LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Duration of account lockout after exceeding login attempts (milliseconds)
# 900000 = 15 minutes
WAHA_LOGIN_RATE_LIMIT_BLOCK_MS=900000

# API Rate Limiting
# Maximum API requests per time window
WAHA_API_RATE_LIMIT_REQUESTS=100

# Time window for API requests (milliseconds)
# 60000 = 1 minute
WAHA_API_RATE_LIMIT_WINDOW_MS=60000

# ============================================================================
# SECURITY FEATURES
# ============================================================================

# Enable Two-Factor Authentication support
WAHA_2FA_ENABLED=true

# Session timeout (milliseconds)
# 86400000 = 24 hours
WAHA_SESSION_TIMEOUT_MS=86400000

# Force HTTPS in production
WAHA_FORCE_HTTPS=false

# Enable comprehensive audit logging
WAHA_AUDIT_LOGGING_ENABLED=true

# Audit log retention period (days)
# Logs older than this will be automatically deleted
WAHA_AUDIT_RETENTION_DAYS=90

# ============================================================================
# DEFAULT ADMIN USER
# ============================================================================

# Default admin user credentials (for initial setup)
# IMPORTANT: Change these after first login!
WAHA_DEFAULT_ADMIN_USERNAME=admin
WAHA_DEFAULT_ADMIN_PASSWORD=change-me-please
WAHA_DEFAULT_ADMIN_EMAIL=admin@example.com

# ============================================================================
# BACKWARD COMPATIBILITY
# ============================================================================

# Support legacy API key authentication alongside new system
# Recommended: true for gradual migration
WAHA_LEGACY_API_KEY_SUPPORT=true

# Support legacy basic auth for dashboard
# Recommended: false (use new login system)
WAHA_LEGACY_BASIC_AUTH_SUPPORT=false

# ============================================================================
# MIGRATION SETTINGS
# ============================================================================

# Automatically migrate from legacy authentication on startup
# Set to 'true' for automatic migration, 'false' for manual migration
WAHA_AUTO_MIGRATE=false

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database type for user management
# Options: 'sqlite', 'postgresql', 'mongodb'
WAHA_AUTH_DATABASE_TYPE=sqlite

# Database connection string (for PostgreSQL/MongoDB)
# WAHA_AUTH_DATABASE_URL=postgresql://user:password@localhost:5432/waha
# WAHA_AUTH_DATABASE_URL=mongodb://localhost:27017/waha

# SQLite database file path (for SQLite)
WAHA_AUTH_DATABASE_PATH=./waha-auth.db

# ============================================================================
# EXISTING WAHA CONFIGURATION
# ============================================================================

# These existing environment variables work with the enhanced authentication:

# Dashboard configuration (legacy - will be replaced by login system)
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=admin

# API Key configuration (legacy - will be migrated to user-based system)
WHATSAPP_API_KEY=your-api-key
# WHATSAPP_API_KEY_HASH=sha512-hash-of-your-api-key

# Swagger authentication (legacy)
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=admin

# ============================================================================
# PRODUCTION RECOMMENDATIONS
# ============================================================================

# For production deployments, ensure:
# 1. WAHA_JWT_SECRET is a strong, unique secret (32+ characters)
# 2. WAHA_FORCE_HTTPS=true
# 3. WAHA_DEFAULT_ADMIN_PASSWORD is changed from default
# 4. WAHA_AUDIT_LOGGING_ENABLED=true
# 5. Rate limiting is configured appropriately for your use case
# 6. Database is properly secured and backed up
# 7. SSL/TLS certificates are properly configured

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# For development, you might want:
# WAHA_AUTH_ENABLED=true
# WAHA_JWT_SECRET=development-secret-not-for-production
# WAHA_FORCE_HTTPS=false
# WAHA_AUTO_MIGRATE=true
# WAHA_LOGIN_RATE_LIMIT_ATTEMPTS=10 (more lenient for testing)

# ============================================================================
# MONITORING AND LOGGING
# ============================================================================

# Pino logging level (existing WAHA setting)
# WAHA_LOG_LEVEL=info

# Enable request logging (existing WAHA setting)
# WAHA_LOG_REQUESTS=true

# ============================================================================
# EXAMPLE CONFIGURATIONS
# ============================================================================

# Minimal setup for testing:
# WAHA_AUTH_ENABLED=true
# WAHA_JWT_SECRET=test-secret-change-in-production-32chars
# WAHA_AUTO_MIGRATE=true

# Production setup:
# WAHA_AUTH_ENABLED=true
# WAHA_JWT_SECRET=<generate-strong-secret>
# WAHA_FORCE_HTTPS=true
# WAHA_DEFAULT_ADMIN_PASSWORD=<strong-password>
# WAHA_AUDIT_LOGGING_ENABLED=true
# WAHA_2FA_ENABLED=true

# Legacy compatibility mode:
# WAHA_AUTH_ENABLED=false
# WAHA_LEGACY_API_KEY_SUPPORT=true
# WAHA_LEGACY_BASIC_AUTH_SUPPORT=true

# WAHA Production Environment Configuration
# Copy this file to .env and update with your production values

# =============================================================================
# SECURITY CONFIGURATION (REQUIRED)
# =============================================================================

# JWT Secret - Generate with: openssl rand -base64 32
WAHA_JWT_SECRET=your-super-secure-jwt-secret-here-32-chars-minimum

# API Key - Generate with: openssl rand -hex 32
WAHA_API_KEY=your-super-secure-api-key-here-64-chars-minimum

# Default Admin Password - Change immediately after first login
WAHA_DEFAULT_ADMIN_PASSWORD=your-secure-admin-password-here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# SQLite (Default - for small deployments)
WAHA_DATABASE_URL=file:./data/waha.db

# PostgreSQL (Recommended for production)
# WAHA_DATABASE_URL=postgresql://waha:password@postgres:5432/waha
# POSTGRES_DB=waha
# POSTGRES_USER=waha
# POSTGRES_PASSWORD=your-secure-postgres-password

# MySQL (Alternative)
# WAHA_DATABASE_URL=mysql://waha:password@mysql:3306/waha

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# CORS Origins (comma-separated)
WAHA_CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
WAHA_RATE_LIMIT_MAX=100
WAHA_RATE_LIMIT_WINDOW=15

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

WAHA_LOG_LEVEL=info
WAHA_LOG_FORMAT=json

# =============================================================================
# OPTIONAL FEATURES
# =============================================================================

# Webhook Configuration
# WAHA_WEBHOOK_URL=https://your-webhook-endpoint.com/webhook
# WAHA_WEBHOOK_EVENTS=message,session.status

# File Upload Limits
# WAHA_MAX_FILE_SIZE=10485760

# Session Configuration
# WAHA_SESSION_TIMEOUT=3600000

# =============================================================================
# INFRASTRUCTURE CONFIGURATION
# =============================================================================

# Domain Configuration
DOMAIN=yourdomain.com
EMAIL=admin@yourdomain.com

# SSL Configuration (for Let's Encrypt)
LETSENCRYPT_EMAIL=admin@yourdomain.com
